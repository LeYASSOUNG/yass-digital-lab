APP_NAME="Yass Digital Lab API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-backend-render.onrender.com
FRONTEND_URL=https://votre-frontend-vercel.vercel.app

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- CONFIGURATION NEON POSTGRESQL ---
DB_CONNECTION=pgsql
DB_HOST=ep-xyz.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=votre_username
DB_PASSWORD=votre_password
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Stripe (si utilisé)
STRIPE_KEY=
STRIPE_SECRET=
